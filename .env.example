# Voz da resposta no canal de áudio da web.
OPENAI_API_KEY=
# Sotaque só existe no gpt-4o-mini-tts; a família tts-1 ignora instructions.
# OPENAI_TTS_INSTRUCTIONS tem default no código — só declare para trocar.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=echo
OPENAI_TTS_SPEED=1.2

INTERPRET_DEBOUNCE_MS=8000
